[Unit]
Description=MasterSeg Agente de monitoramento
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=masterseg
WorkingDirectory=/opt/masterseg-agente
ExecStart=/opt/masterseg-agente/venv/bin/python /opt/masterseg-agente/agente.py
Restart=always
RestartSec=10
# Watchdog do systemd: se o processo morrer, volta em 10s.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/masterseg-agente

[Install]
WantedBy=multi-user.target
